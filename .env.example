# Copy to .env.local for local development. Never commit a populated environment file.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate at least 48 random bytes: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
ADMIN_EMAILS=
CONTACT_EMAIL=connect@techcyme.com
# Role mailboxes shown on the site. Create these in Google Workspace before launch.
EMAIL_CONNECT=connect@techcyme.com
EMAIL_CONTACT=contact@techcyme.com
EMAIL_SUPPORT=support@techcyme.com
EMAIL_DELIVERY=delivery@techcyme.com
EMAIL_TEAM=team@techcyme.com
SQLITE_PATH=.data/techcyme.db
# For managed PostgreSQL instead of SQLite. Configure trusted TLS according to your provider.
# DATABASE_URL=postgresql://...
LAUNCH_APPROVED=false
LEGAL_BUSINESS_NAME=
LEGAL_BUSINESS_ADDRESS=
LEGAL_REVIEWED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_WORKER_CONFIRMED=false
BACKUP_RESTORE_CONFIRMED=false
MONITORING_CONFIRMED=false
NEXT_TELEMETRY_DISABLED=1
