{
  "name": "techcyme",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "admin:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-admin.ts",
    "notifications:send": "node --env-file-if-exists=.env.local --import tsx scripts/send-notifications.ts",
    "check:launch": "node --env-file-if-exists=.env.local --import tsx scripts/check-launch.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "icons:build": "node scripts/build-icons.mjs && node scripts/prepare-assets.mjs",
    "postinstall": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@refinedev/antd": "^6.0.3",
    "@refinedev/core": "^5.0.12",
    "@refinedev/nextjs-router": "^7.0.5",
    "antd": "^5.29.3",
    "better-auth": "^1.7.12",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "geist": "1.8.1",
    "kysely": "^0.29.7",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "smtp-server": "^3.20.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "path-to-regexp": "^8.4.0"
  },
  "type": "module"
}
